From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaid Ajaj <zaid.naom@gmail.com>
Date: Wed, 14 Oct 2026 13:26:22 +0200
Subject: [PATCH] Set the storage account ID when migrating share state from v4


diff --git a/internal/services/storage/migration/storage_share_v2_to_v3.go b/internal/services/storage/migration/storage_share_v2_to_v3.go
index 14c687568c17..a3e561133962 100644
--- a/internal/services/storage/migration/storage_share_v2_to_v3.go
+++ b/internal/services/storage/migration/storage_share_v2_to_v3.go
@@ -7,6 +7,7 @@ import (
 	"context"
 	"errors"
 	"fmt"
+	"strings"
 
 	"github.com/hashicorp/go-azure-helpers/resourcemanager/commonids"
 	"github.com/hashicorp/go-azure-sdk/resource-manager/storage/2025-08-01/fileshares"
@@ -112,7 +113,9 @@ func (StorageShareV2ToV3) UpgradeFunc() pluginsdk.StateUpgraderFunc {
 		}
 
 		storageAccountID, err := resolveStorageAccountIDForStateUpgrade(ctx, meta, rawState, func(idStr string) (*commonids.StorageAccountId, error) {
-			id, err := fileshares.ParseShareIDInsensitively(idStr)
+			// FORK: v4 recorded the `resource_manager_id` of a share with a `fileshares` segment rather than
+			// `shares`. Accept it, rather than falling back to looking the account up in Azure by name.
+			id, err := fileshares.ParseShareIDInsensitively(strings.Replace(idStr, "/fileshares/", "/shares/", 1))
 			if err != nil {
 				return nil, err
 			}
@@ -133,6 +136,10 @@ func (StorageShareV2ToV3) UpgradeFunc() pluginsdk.StateUpgraderFunc {
 		}
 
 		rawState["id"] = fileshares.NewShareID(storageAccountID.SubscriptionId, storageAccountID.ResourceGroupName, storageAccountID.StorageAccountName, name).ID()
+		// FORK: like the container, queue and table migrations, replace `storage_account_name` with
+		// `storage_account_id`. Left unset, it differs from the configuration and replaces the share.
+		rawState["storage_account_id"] = storageAccountID.ID()
+		delete(rawState, "storage_account_name")
 
 		return rawState, nil
 	}
